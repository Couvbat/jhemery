# Vite inlines these at build time, so this file has to exist in the repo for
# the CI build to pick it up -- a .env sitting on the server does nothing for a
# static bundle. Without it, VITE_API_URL falls back to the localhost default in
# src/lib/api.ts and the deployed site calls an API that isn't there.
#
# Not a secret: it ships in the JavaScript either way.
VITE_API_URL=https://api.jhemery.xyz
