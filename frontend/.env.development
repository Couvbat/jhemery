VITE_API_URL=http://localhost:3000

# Analytics is off in dev on purpose: with these unset, src/lib/analytics.ts never
# injects the tracker, so a hot-reloading dev server cannot fill the dashboard with
# pageviews of localhost. Uncomment both to check the wiring against the real
# instance — VITE_UMAMI_DOMAINS stays commented out then, since it would make the
# tracker discard everything sent from localhost.
# VITE_UMAMI_SRC=https://umami.jhemery.xyz/script.js
# VITE_UMAMI_WEBSITE_ID=
