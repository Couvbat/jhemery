# NestJS
PORT=3000
FRONTEND_URL=http://localhost:5173

# SMTP (leave empty to only log messages in dev)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_password
CONTACT_TO=jules@jhemery.xyz

# Steam (leave empty to hide live activity and fall back to static data)
# Get a free API key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_web_api_key
# Either your SteamID64 or your custom profile URL name (steamcommunity.com/id/<this>)
STEAM_ID=your_steamid64_or_vanity_name

# GitHub (leave empty to hide the recent-commits card)
GITHUB_USERNAME=Couvbat
# Raises the public API rate limit, and is REQUIRED for the contribution heatmap and
# pinned-repos cards — both are only available through GitHub's GraphQL API, which
# rejects anonymous requests. A classic token with no scopes is enough for public data.
GITHUB_TOKEN=
# `owner/name` of the repo whose Actions runs feed the build-status card.
# Leave empty and the card is simply not rendered. Public REST, so the token
# above is optional here — it only raises the rate limit.
GITHUB_REPO=Couvbat/jhemery

# Weather — Open-Meteo, no key and no account needed.
# These coordinates are YOURS, not the visitor's: nothing about the caller is
# read or sent, so every visitor gets the same answer and one cache serves them
# all. Leave the pair empty (the default) and `weather` reports itself
# unconfigured and the background keeps its normal mood.
# Empty on purpose rather than pre-filled: the site says only "France" about
# where Jules is, and a committed lat/long would be more precise than that.
# Put real coordinates in `.env` on the server, at whatever precision you are
# comfortable publishing — a city centre is plenty.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# Display name only, shown as typed — never used to look anything up.
WEATHER_LOCATION=

# Markets (`btc` / `stonks`) — CoinGecko's public endpoint, no key and no
# account. A proxy purely because CORS blocks the browser from calling an
# exchange directly; the coin list comes from here, never from the request, so
# there is no query a visitor can steer. Cached 5 minutes and only fetched when
# someone actually runs the command. Set MARKETS_COINS empty to turn it off.
# CoinGecko coin ids, comma-separated (`bitcoin`, not `BTC`).
MARKETS_COINS=bitcoin,ethereum
MARKETS_CURRENCY=eur

# Guestbook — a publicly writable field, so it is off unless you opt in.
# Entries are sanitised, link-filtered, rate-limited to 1/min per IP, capped at 500.
GUESTBOOK_ENABLED=false
# Where guestbook.json is written. Relative paths resolve from the app root.
# `uploads` is excluded from the deploy, so entries survive deploys.
# Only used when MONGODB_URI (below) is empty.
DATA_DIR=uploads
# Optional. Point at your own MongoDB instance to store guestbook entries there
# instead of the JSON file, e.g. mongodb://user:pass@host:27017/portfolio
# Leave empty to keep using the JSON file.
MONGODB_URI=
# Required to use DELETE /guestbook/:id (send it as the x-admin-password header).
# Leave empty and the endpoint always refuses.
ADMIN_PASSWORD=

# `ask` — the terminal's self-hosted LLM. Off unless you opt in: it is a public
# endpoint that spends a private machine's electricity, and it is the only one
# that opens a path towards a home network. Unset or unreachable, the terminal
# says the model is asleep and points at `mail`.
# Rate-limited to 5 questions/hour per IP, one in flight globally, ~300 tokens
# out, 20s timeout. Questions and answers are never logged.
ASK_ENABLED=false
# Any OpenAI-compatible runtime — the URL that has /chat/completions under it.
# Ollama:     https://llm.example.com/v1   (the host plus /v1)
# llama.cpp:  http://192.168.1.10:8080/v1
# vLLM:       http://192.168.1.10:8000/v1
# LM Studio:  http://192.168.1.10:1234/v1
# A placeholder on purpose — put the real host in `.env` on the server, not
# here. A self-hosted endpoint usually has no auth of its own, and the 5/hour
# limit below guards this API's route, not the model behind it: anyone who
# reads the URL in a public repo can skip the limiter entirely.
LLM_BASE_URL=https://llm.example.com/v1
# Whatever the runtime calls it — `ollama list` for Ollama.
# Reasoning models (gemma4, qwen3, …) work: the request asks for
# `reasoning_effort: none`, without which chain-of-thought eats the whole
# 300-token budget and the answer arrives truncated mid-sentence.
LLM_MODEL=gemma4:e4b
# Optional; sent as `Authorization: Bearer` when set. Ollama needs no key.
LLM_API_KEY=
