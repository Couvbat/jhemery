{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // src/ alone, so the output lands at dist/main.js where start:prod and the
    // deploy expect it. The build info goes inside dist/ too: beside this file it
    // would outlive `deleteOutDir` and sit untracked in every checkout.
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  // scripts/ are run by hand with tsx (eval-moderation.ts), never deployed: outside
  // src/, they would only break the rootDir above.
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
