# NestJS 12 ships as ES modules only, and the CommonJS specs reach it through
# require(). Jest supports that on Node 24 only with VM modules enabled, so every
# Node that npm starts here gets the flag: `npm test` in CI and `npx jest` alike.
# Production never runs through npm (Passenger starts dist/main.js itself), and
# plain Node needs no flag to require() an ES module.
node-options=--experimental-vm-modules
